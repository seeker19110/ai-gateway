# AI Gateway - biến môi trường
# Copy file này thành .env và điền những key bạn có.
# Nhà cung cấp không có key sẽ tự động nằm ngoài pool — không cần điền đủ.

# Google Gemini (miễn phí: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (miễn phí: https://console.groq.com/keys)
GROQ_API_KEY=

# Cerebras (miễn phí: https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# OpenRouter (có model :free: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Together AI (có model Free: https://api.together.xyz/settings/api-keys)
TOGETHER_API_KEY=

# Mistral AI (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# Cohere (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
CLAUDE_API_KEY=

# Cổng server (mặc định 3000)
PORT=3000
