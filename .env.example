# AI Gateway - biến môi trường
# Copy file này thành .env và điền những key bạn có.
# Nhà cung cấp không có key sẽ tự động nằm ngoài pool — không cần điền đủ.

# ---------------------------------------------------------------------------
# NHIỀU TÀI KHOẢN CHO MỘT NHÀ CUNG CẤP
#
# Mỗi API key là một tài khoản riêng, có hạn mức riêng và cooldown riêng: một key
# Gemini hết hạn mức phút KHÔNG kéo theo key Gemini thứ hai. Ba cách khai báo, dùng
# cách nào cũng được và trộn lẫn cũng được:
#
#   GEMINI_API_KEY=AIza...                        một key
#   GEMINI_API_KEYS=AIza...,AIza...               danh sách (phẩy, chấm phẩy, xuống dòng)
#   GEMINI_API_KEY_2=AIza...                      mỗi key một biến (tiện cho Docker/K8s secret)
#
# Đặt tên cho tài khoản để bảng trạng thái gọi đúng tên thay vì `gemini#2`:
#   GEMINI_API_KEYS=ca-nhan=AIza...,cong-ty=AIza...
#
# Key trùng nhau bị loại tự động theo dấu vân tay.
# ---------------------------------------------------------------------------

# Google Gemini (miễn phí: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (miễn phí: https://console.groq.com/keys)
GROQ_API_KEY=

# Cerebras (miễn phí: https://cloud.cerebras.ai)
CEREBRAS_API_KEY=

# OpenRouter (có model :free: https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Together AI (có model Free: https://api.together.xyz/settings/api-keys)
TOGETHER_API_KEY=

# Mistral AI (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=

# Cohere (https://dashboard.cohere.com/api-keys)
COHERE_API_KEY=

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
CLAUDE_API_KEY=

# ---------------------------------------------------------------------------
# Model và hạn mức
#
# Tên model trong code là ảnh chụp của một thời điểm. Hãng cho model cũ nghỉ hưu theo
# lịch riêng của họ, và khi đó mọi lượt đi qua nhà đó trả 404 — một lỗi 4xx bị xếp vào
# "lỗi phía client, không xoay vòng", nên nó làm đứng cả pool. Sửa ở đây là chuyện một
# phút; không có nó thì phải chờ một bản phát hành.
#
# Hạn mức phút cũng vậy: số mặc định trong code chỉ đúng cho bậc miễn phí.
# ---------------------------------------------------------------------------
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MAX_RPM=30

# ---------------------------------------------------------------------------
# Xoay vòng
# ---------------------------------------------------------------------------
# GATEWAY_ROTATION=account   # account (mặc định): chia đều theo TÀI KHOẢN, nên nhà có 5 key
#                            #   nhận ~5 phần còn nhà có 1 key nhận 1 phần — đúng bằng tỉ lệ
#                            #   hạn mức thật sự có.
#                            # provider: chia đều theo NHÀ CUNG CẤP, bất kể mỗi nhà mấy key.
# GATEWAY_MAX_ATTEMPTS=6     # trần số lần thử cho MỘT request (0 = không giới hạn)
# GATEWAY_STATE_FILE=~/.ai-gateway/cooldowns.json

# Cổng server (mặc định 3000)
PORT=3000
